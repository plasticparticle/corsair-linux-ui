{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Corsair Control",
  "version": "0.1.0",
  "identifier": "dev.corsaircontrol.linux",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Corsair Control",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset:; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [],
    "targets": "all"
  }
}
